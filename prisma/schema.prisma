generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model JobPost {
  id                String           @id @default(cuid())
  status            String           @default("pending")
  postType          String
  imageUrl          String?
  jobTitle          String
  description       String?
  projectType       String
  customProjectType String?
  industry          String?
  customIndustry    String?
  currency          String           @default("USD")
  salary            String
  experience        String
  qualification     String
  location          String
  companyName       String
  posterName        String?
  posterPhone       String?
  posterEmail       String?
  sourceUrl         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  approvedAt        DateTime?
  viewCount         Int              @default(0)
  applications      JobApplication[]
}

model JobApplication {
  id         String   @id @default(cuid())
  jobPostId  String
  jobPost    JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  email      String
  resumeLink String?
  message    String?
  appliedAt  DateTime @default(now())
}

// Caches external job-API search results to protect free-tier quota.
// `id` is the cache key: `${normalizedQuery}::${page}`.
model SearchCache {
  id         String   @id
  query      String
  page       Int      @default(1)
  results    String   // JSON array string of normalized web results
  totalCount Int      @default(0)
  fetchedAt  DateTime @default(now())
}
